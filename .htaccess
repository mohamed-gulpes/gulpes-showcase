# Legacy host only (Hostinger / LiteSpeed). Production is now GitHub Pages, which
# ignores this file. It stays so the old host keeps behaving while DNS moves over.

# med.gulpes.com is retired: the profile lives at gulpes.com/med.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^med\.gulpes\.com$ [NC]
  RewriteRule ^.*$ https://gulpes.com/med.html [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>
